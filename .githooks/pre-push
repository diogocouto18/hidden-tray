#!/usr/bin/env bash
# Block direct pushes to master: changes go through feature branches and PRs.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [[ "$remote_ref" == "refs/heads/master" ]]; then
        echo "pre-push: direct pushes to master are blocked; open a PR from a feature branch." >&2
        exit 1
    fi
done
exit 0
